	author = {Lipu, Molla S. Hossain and Faisal, Mohammad and Ansari, Shaheer and Hannan, Mahammad A. and Karim, Tahia F. and Ayob, Afida and Hussain, Aini and Miah, Md Sazal and Saad, Mohamad Hanif Md},
	urldate = {2025-01-13},
	date = {2021-01},
	langid = {english},
	keywords = {electric vehicle, battery storage systems, {DC}-{DC} converter, intelligent controller, metaheuristic optimization, modulation techniques},
	file = {Full Text PDF:/home/diego/Zotero/storage/RFSTE964/Lipu et al. - 2021 - Review of Electric Vehicle Converter Configurations, Control Schemes and Optimizations Challenges a.pdf:application/pdf},
}

