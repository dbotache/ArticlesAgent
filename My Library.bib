	date = {2023-07},
	keywords = {Torque, Predictive models, Mathematical models, Couplings, Stators, Continuous control set, model predictive control, permanent magnet synchronous motor ({PMSM}), torque control, Transient analysis, time optimal control ({TOC}), Trajectory},
	file = {Full Text PDF:/home/diego/Zotero/storage/6N3Z8ZWG/Brosch et al. - 2023 - Time-Optimal Model Predictive Control of Permanent Magnet Synchronous Motors Considering Current and.pdf:application/pdf;IEEE Xplore Abstract Record:/home/diego/Zotero/storage/DUB7CY6U/10098161.html:text/html},
