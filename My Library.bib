	date = {2023-06},
	keywords = {Estimation, Permanent magnet motors, Stator windings, {PMSM}, Traction motors, Synchronous motors, Circuit faults, {ITSC}, safe operating area, Short circuit current, Short-circuit currents},
	file = {Full Text PDF:/home/diego/Zotero/storage/XBKD6FF7/Baruti et al. - 2023 - Online Stator Inter-Turn Short Circuit Estimation and Fault Management in Permanent Magnet Motors.pdf:application/pdf;IEEE Xplore Abstract Record:/home/diego/Zotero/storage/SJA7NPN8/9942361.html:text/html},
