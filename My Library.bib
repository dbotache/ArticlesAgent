@misc{holsch_evaluation_2025,
	title = {Evaluation of the Efficiency Measurement Uncertainty of Electric Drive Test Benches for Direct Data-Driven Control Optimization},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	url = {https://www.techrxiv.org/users/706851/articles/1253393-evaluation-of-the-efficiency-measurement-uncertainty-of-electric-drive-test-benches-for-direct-data-driven-control-optimization?commit=770efbcd5b481bf2f2c42aa35ece98bf2bb67c23},
	doi = {10.36227/techrxiv.173603411.17559954/v1},
	abstract = {Increasing efficiency of electric drives combining electrical machines, power electronics and control algorithms, is a major task in industry and academia. Considering the already high efficiency levels of modern drive systems, expected improvements are in the single digit and below percentage point range. Therefore, a low measurement uncertainty of the electrical input and the mechanical output power is necessary to compare the efficiency of different drive designs or to perform an online optimization of control-related operation strategies (such as optimal pulse patterns). Hence, a measurement model is proposed to analyze the occurring power and efficiency uncertainty along the measurement chain in the whole torque-speed plane of threephase drive test benches. This measurement model is published as an open-source software, allowing others to evaluate their test bench setup or to optimize new test bench designs during the specification process. An exemplary evaluation for a traction drive test bench demonstrates the functionality of the proposed model and highlights the importance of rigorous measurement uncertainty assessments in today’s data-driven world.},
	author = {Hölsch, Lukas and Wallscheid, Oliver},
	urldate = {2025-01-08},
	date = {2025-01},
	langid = {english},
	file = {PDF:/home/diego/Zotero/storage/V5DJLWSB/Hölsch und Wallscheid - 2025 - Evaluation of the Efficiency Measurement Uncertainty of Electric Drive Test Benches for Direct Data-.pdf:application/pdf},
}

@inproceedings{gedlu_online_2023,
	title = {Online system identification and excitation for thermal monitoring of electric machines using machine learning and model predictive control},
	url = {https://ieeexplore.ieee.org/document/10271427},
	doi = {10.1109/SDEMPED54949.2023.10271427},
	abstract = {Data-driven thermal models are demonstrated to be practical for real-time temperature estimation in electric drive applications. However, the model’s performance and scope are highly influenced by the information contained in the empirical dataset. So far, thermal modeling and system excitation are separate processes where the system is excited using offline-designed, open-loop experiments that do not consider the system or model responses. This typically requires lengthy experimental measurement sessions at test benches and the missing feedback for the excitation leads to biased data distributions in the state-input space. To overcome these issues, model predictive based closed-loop system excitation is introduced, which identifies a neural network-based thermal model online using the continual data stream. Simulation results show that a significantly improved state-input dataset distribution can be achieved with the proposed solution in less time than traditional open-loop offline design of experiment strategies.},
	pages = {109--115},
	booktitle = {2023 {IEEE} 14th International Symposium on Diagnostics for Electrical Machines, Power Electronics and Drives ({SDEMPED})},
