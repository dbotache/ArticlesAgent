@article{antonietti_mathematical_2022,
	title = {On Mathematical and Numerical Modelling of Multiphysics Wave Propagation with Polytopal Discontinuous Galerkin Methods: a Review},
	volume = {50},
	issn = {2305-2228},
	url = {https://doi.org/10.1007/s10013-022-00566-3},
	doi = {10.1007/s10013-022-00566-3},
	shorttitle = {On Mathematical and Numerical Modelling of Multiphysics Wave Propagation with Polytopal Discontinuous Galerkin Methods},
	abstract = {In this work we review discontinuous Galerkin finite element methods on polytopal grids ({PolydG}) for the numerical simulation of multiphysics wave propagation phenomena in heterogeneous media. In particular, we address wave phenomena in elastic, poro-elastic, and poro-elasto-acoustic materials. Wave propagation is modeled by using either the elastodynamics equation in the elastic domain, the acoustics equations in the acoustic domain and the low-frequency Biot’s equations in the poro-elastic one. The coupling between different models is realized by means of (physically consistent) transmission conditions, weakly imposed at the interface between the subdomains. For all models configuration, we introduce and analyse the {PolydG} semi-discrete formulation, which is then coupled with suitable time marching schemes. For the semi-discrete problem, we present the stability analysis and derive a-priori error estimates in a suitable energy norm. A wide set of two-dimensional verification tests with manufactured solutions are presented in order to validate the error analysis. Examples of physical interest are also shown to demonstrate the capability of the proposed methods.},
	pages = {997--1028},
	number = {4},
	journaltitle = {Vietnam Journal of Mathematics},
	author = {Antonietti, Paola F. and Botti, Michele and Mazzieri, Ilario},
	urldate = {2023-05-17},
	date = {2022-10},
	langid = {english},
	keywords = {35L05, 65M12, 65M60, 74F10, Acoustics, Discontinuous Galerkin method, Polygonal and polyhedral meshes, Poroelasticity, Stability and convergence analysis},
}

@article{siddiqui_comprehensive_2022,
	title = {A comprehensive review on multi-physics modeling of photovoltaic modules},
