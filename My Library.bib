	keywords = {axial flux motor ({AFM}), electric machine, electromagnetic noise, induction motor, noise calculation, noise reduction methods, permanent magnet motor ({PMM})},
	file = {PDF:/home/diego/Zotero/storage/KTTWGJXY/Gonzalez et al. - 2023 - Noise in Electric Motors A Comprehensive Review.pdf:application/pdf},
}

@article{kang_analysis_2017,
