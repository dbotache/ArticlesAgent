	file = {IEEE Xplore Abstract Record:/home/diego/Zotero/storage/C2G58PUU/stamp.html:text/html;IEEE Xplore Abstract Record:/home/diego/Zotero/storage/6ZD3IMA7/stamp.html:text/html;PDF:/home/diego/Zotero/storage/W93TEH8B/Schneider et al. - 2022 - Solving geometry conflicts in GA Optimizations with large numbers of geometric parameters.pdf:application/pdf},
