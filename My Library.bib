@article{hwang_design_2018,
	title = {Design and Analysis of Rotor Shapes for {IPM} Motors in {EV} Power Traction Platforms},
	volume = {11},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1996-1073},
