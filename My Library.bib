	file = {Full Text PDF:/home/diego/Zotero/storage/U2WWINI8/Gedlu et al. - 2023 - Online system identification and excitation for thermal monitoring of electric machines using machin.pdf:application/pdf;IEEE Xplore Abstract Record:/home/diego/Zotero/storage/DX4QFJFR/10271427.html:text/html},
