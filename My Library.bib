	urldate = {2025-01-10},
	date = {2023-12},
	keywords = {Data models, Temperature measurement, Neural networks, machine learning, Magnetic flux, Magnetic hysteresis, Magnetic cores, Core loss, data-driven method, hysteresis loop, neural network, open-source database, power magnetics},
	file = {Full Text PDF:/home/diego/Zotero/storage/JRWQJ2H9/Li et al. - 2023 - How MagNet Machine Learning Framework for Modeling Power Magnetic Material Characteristics.pdf:application/pdf;IEEE Xplore Abstract Record:/home/diego/Zotero/storage/WDQCNCC2/10232863.html:text/html},
