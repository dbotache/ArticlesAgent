	urldate = {2025-01-08},
	date = {2021},
	keywords = {Estimation, Permanent magnet motors, Stator windings, Temperature measurement, Temperature sensors, Monitoring, survey, Stators, system identification, thermal modeling, electric drives, monitoring, safety, Temperature estimation},
