# Copy to .env and fill in (or use the app: ⚙️ Models & API keys). Never commit .env.
CHAT_PROVIDER=azure                  # azure | openai | anthropic | compatible
CHAT_MODEL=gpt-4.1-mini              # Azure: deployment name
# FAST_PROVIDER=                     # optional search helper; defaults to the chat model
# FAST_MODEL=
EMBEDDING_PROVIDER=azure             # azure | openai | compatible – default for NEW projects
EMBEDDING_MODEL=text-embedding-3-small

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_BASE_URL=                 # e.g. http://localhost:11434/v1 (Ollama)
COMPATIBLE_API_KEY=

# Repository of the code this installation runs (AGPL-3.0 §13 link in the app); default: upstream.
# SOURCE_CODE_URL=https://github.com/dbotache/ArticlesAgent
